  "ui.goal.build": "{0}",
  "ui.goal.event.handbook": "возьмёшь справочник со стола в лаборатории",
  "ui.goal.event.sleep": "поспишь на лежанке",
  "ui.bed.spawn_set": "Точка возрождения — здесь",
